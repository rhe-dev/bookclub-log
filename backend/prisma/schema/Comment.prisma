/// 책 단위 토론 스레드의 코멘트·답글 — 작성자만 수정·삭제 가능
model Comment {
  id        Int       @id @default(autoincrement())
  publicId  String    @unique @default(cuid()) /// API 경로·응답용 식별자 (D-014)
  bookId    Int
  memberId  Int /// 작성자
  parentId  Int? /// null이면 코멘트, 있으면 해당 코멘트의 답글 — 스레드는 1단계까지만
  page      Int? /// 선택 앵커: 언급하는 페이지
  quote     String? /// 선택 앵커: 인용 문장
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt /// createdAt과 다르면 UI에 '수정됨' 표시
  deletedAt DateTime? /// 소프트 딜리트 — 답글 보존을 위해 '삭제된 코멘트'로 자리 유지 (D-010)

  book    Book          @relation(fields: [bookId], references: [id])
  member  Member        @relation(fields: [memberId], references: [id])
  parent  Comment?      @relation("CommentReplies", fields: [parentId], references: [id])
  replies Comment[]     @relation("CommentReplies")
  likes   CommentLike[]
}

/// 코멘트 공감(좋아요) — 멤버당 코멘트 1회, 재클릭 시 해제(토글)
model CommentLike {
  commentId Int
  memberId  Int
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id])
  member  Member  @relation(fields: [memberId], references: [id])

  @@id([commentId, memberId])
}
