/// 전역 회원 — 모임 소속·역할은 ClubMember로 관리 (D-015).
/// 로그인 없이 입장 화면에서 프로필 선택으로 현재 멤버를 정한다 (PLAN §7)
model Member {
  id          Int    @id @default(autoincrement())
  publicId    String @unique @default(cuid()) /// API 경로·응답용 식별자 (D-014)
  name        String
  avatarEmoji String /// 프로필 아바타 — 이미지 업로드 대신 이모지 (PLAN §7)
  color       String /// 프로필 배경색(HEX)

  memberships    ClubMember[]
  participations BookParticipant[]
  comments       Comment[]
  commentLikes   CommentLike[]
  orders         Order[]
}
